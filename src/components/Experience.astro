---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    title: "Desarrollador Frontend Semi Senior",
    company: "Indigo Technologies LATAM",
    date: "Enero 2024 - Actualmente",
    description: [
      "Desarrollé una nueva versión de un visor de imágenes médicas con React y TypeScript, modernizando la arquitectura y la experiencia de usuario y reduciendo aproximadamente un 40% los tiempos de carga de imágenes. El producto obtuvo posteriormente la aprobación de la FDA.",
      "Implementé pruebas unitarias con más del 95% de cobertura en frontend y pruebas en backend para aumentar la confiabilidad y reducir regresiones.",
      "Modernicé el backend en C# y .NET, migrándolo a .NET 10 y aplicando Clean Architecture y arquitectura hexagonal para mejorar la mantenibilidad, el desacoplamiento y la escalabilidad.",
      "Desarrollé una nueva versión del portal de pacientes e implementé observabilidad con New Relic para monitorear errores, rendimiento y tiempos de carga en producción.",
      "Desplegué aplicaciones con Docker y Kubernetes en AKS, reduciendo aproximadamente un 30% los costos de infraestructura frente a App Service Windows."
    ],
  },
  {
    title: "Desarrollador Frontend",
    company: "Kaba Law Group",
    date: "Abril 2023 - Enero 2024",
    description: [
      "Desarrollé interfaces responsivas y fieles a los diseños de Figma con Next.js, React, TypeScript, Redux Toolkit y Tailwind CSS, creando componentes reutilizables.",
      "Integré APIs REST y comunicación en tiempo real con WebSockets.",
      "Refactoricé componentes y flujos existentes para mejorar la mantenibilidad, estabilidad y reutilización del código."
    ],
  }
];
---

<ol class="relative border-s-2 border-gray-400 dark:border-gray-600 mt-12">
  {EXPERIENCE.map((experience, index) => <ExperienceItem {...experience} index={index} />)}
</ol>
