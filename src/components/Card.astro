---
import { Image } from "astro:assets";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";

interface Props {
  title: string;
  description: string;
  githubLink: string | null;
  previewLink: string;
  url: string;
  badges: string[];
  index: number;
}

const { title, description, previewLink, githubLink, url, badges, index } =
  Astro.props;
const prefix = `projects.items.${index}`;
---

<article
  class="relative flex flex-col md:flex-row md:space-x-5 space-y-3 md:space-y-0 rounded-lg shadow p-3 max-w-xs md:max-w-full mx-auto bg-white border-gray-200 border dark:bg-[#171717] dark:border-[#383838]"
>
  <div class="w-full md:w-1/3 grid place-items-center">
    <Image
      width={300}
      height={300}
      src={url}
      alt={title}
      class="rounded"
    />
  </div>
  <div class="w-full md:w-2/3 flex flex-col space-y-2 p-3">
    <h3 class="font-black text-gray-800 dark:text-white md:text-3xl text-xl" data-i18n={`${prefix}.title`}>
      {title}
    </h3>
    <div class="flex flex-wrap gap-1">
      {badges.map((name) => <Badge name={name} />)}
    </div>
    <p class="text-black dark:text-white" data-i18n={`${prefix}.description`}>
      {description}
    </p>
    <div class="flex items-center gap-4">
      <Button href={previewLink}>
        <Link class="size-5" /><span data-i18n="card.view">Ver</span>
      </Button>
      {githubLink && (
        <Button href={githubLink}>
          <GitHub class="size-5" />
          <span data-i18n="card.code">Código</span>
        </Button>
      )}
    </div>
  </div>
</article>
