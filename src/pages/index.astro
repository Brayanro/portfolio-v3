---
import AboutMe from "@components/AboutMe.astro";
import Experience from "@components/Experience.astro";
import Hero from "@components/Hero.astro";
import Projects from "@components/Projects.astro";
import SectionContainer from "@components/SectionContainer.astro";
import Skills from "@components/Skills.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Brayan Rodriguez Montealegre | Desarrollador Frontend Semi Senior"
  description="Desarrollador Frontend Semi Senior con más de 3 años de experiencia en React, Next.js y TypeScript. Especializado en arquitectura frontend, rendimiento, testing y observabilidad."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
    <SectionContainer class="pb-12" id="experience">
      <h1
        class="font-semibold tracking-tight text-gray-800 text-4xl dark:text-white"
        data-i18n="sections.experience"
      >
        Experiencia laboral
      </h1>
      <Experience />
    </SectionContainer>
    <SectionContainer class="pb-12" id="projects">
      <h3
        class="font-semibold tracking-tight text-gray-800 text-4xl dark:text-white"
        data-i18n="sections.projects"
      >
        Proyectos
      </h3>
      <Projects />
    </SectionContainer>
    <SectionContainer class="pb-12" id="skills">
      <h3
        class="font-semibold tracking-tight text-gray-800 text-4xl dark:text-white"
        data-i18n="sections.skills"
      >
        Habilidades
      </h3>
      <Skills />
    </SectionContainer>
    <SectionContainer id="about-me">
      <h3
        class="font-semibold tracking-tight text-gray-800 text-4xl dark:text-white"
        data-i18n="sections.aboutMe"
      >
        Sobre mi
      </h3>
      <AboutMe />
    </SectionContainer>
  </main>
</Layout>
